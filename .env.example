# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env.local for development or .env.production for production
# and fill in all required values with your actual credentials.
# ============================================================================

NODE_ENV=production

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Instructions:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Project Settings > API
# 3. Copy URL and anon key to NEXT_PUBLIC_SUPABASE_URL/KEY
# 4. Copy service role key to SUPABASE_SERVICE_ROLE_KEY (keep this secret!)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here-with-eyJ...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-keep-secret

# ============================================================================
# AUTHENTICATION CONFIGURATION (Required)
# ============================================================================
# Generate a secure secret:
#   openssl rand -base64 32
# This is used to sign and verify session tokens.

APP_AUTH_SECRET=generate-with-openssl-rand-base64-32

# ============================================================================
# OTP CONFIGURATION (Optional)
# ============================================================================
# These settings control OTP (One-Time Password) behavior for registration.

# OTP digit length (4-8 digits, default: 6)
APP_OTP_LENGTH=6

# OTP expiration time in minutes (1-30 minutes, default: 5)
APP_OTP_EXPIRES_MINUTES=5

# Set to true in development to show OTP in console/response. 
# NEVER set to true in production!
APP_OTP_DEV_MODE=false

# SMS template for OTP - {otp} and {minutes} are replaced with actual values
APP_OTP_SMS_TEMPLATE=Your OTP is {otp}. It expires in {minutes} minutes.

# ============================================================================
# SMS PROVIDER CONFIGURATION
# ============================================================================
# Choose which SMS provider to use: "twilio", "2factor", or "console"
# - twilio: Uses Twilio SMS service (requires credentials)
# - 2factor: Uses 2Factor.in service (requires credentials)
# - console: Logs SMS to console (for testing/development only)

APP_SMS_PROVIDER=console

# --- TWILIO CONFIGURATION ---
# Get these from your Twilio account: https://console.twilio.com
# TWILIO_ACCOUNT_SID: Your account SID
# TWILIO_AUTH_TOKEN: Your auth token
# TWILIO_FROM: Phone number messages will be sent from (in E.164 format)
# TWILIO_MESSAGING_SERVICE_SID: Messaging service SID (optional, used instead of TWILIO_FROM)

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 2FACTOR.IN CONFIGURATION ---
# Get these from your 2Factor.in account: https://2factor.in
# TWOFACTOR_API_KEY: Your API key
# TWOFACTOR_OTP_TEMPLATE: Your OTP template ID
# TWOFACTOR_MODE: "autogen" or "template"

TWOFACTOR_BASE_URL=https://2factor.in/API/V1
TWOFACTOR_API_KEY=your-api-key
TWOFACTOR_OTP_TEMPLATE=your-template-id
TWOFACTOR_MODE=autogen

# ============================================================================
# OPTIONAL: Application URLs
# ============================================================================
# Set this if you need to reference your app URL in code
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
